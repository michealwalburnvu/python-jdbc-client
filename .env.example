# Copy to .env and fill in. .env is gitignored.
# No credentials go here: the client authenticates with the Kerberos ticket in
# your macOS credential cache (`klist` to check, `kinit` to get one).

# SQL Server host (the cname) and database
MSSQL_SERVER=your-sql-host.veteransunited.com
MSSQL_DATABASE=Dqe
MSSQL_PORT=1433

# Service principal name. Normally derived automatically by following the
# host's CNAME to its canonical name (MSSQLSvc/<canonical-host>:<port>).
# Only set this if the SPN differs from that.
# MSSQL_SPN=MSSQLSvc/real-host.vuhl.root.mrc.local:1433

# Encrypted connection, trusting the server certificate (JDBC equivalent of
# encrypt=true;trustServerCertificate=true). Both default to true.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=true

# Login timeout (seconds)
MSSQL_TIMEOUT=30
